# ═══════════════════════════════════════════════════════════
# ContentPilot — environment configuration
# Copy to `.env` and fill in. Never commit real secrets.
#
#   cp .env.example .env
#
# Per-tenant API keys can also live in Settings → Integrations;
# env vars below are global fallbacks + infrastructure.
# Full on-prem guide: DEPLOY.md
# ═══════════════════════════════════════════════════════════

# ── Runtime ───────────────────────────────────────────────
# development | production | test
NODE_ENV=development

# ── Branding (web + API) ──────────────────────────────────
APP_NAME=ContentPilot
APP_TAGLINE=Content Engine
NEXT_PUBLIC_APP_NAME=ContentPilot
NEXT_PUBLIC_APP_TAGLINE=Content Engine
NEXT_PUBLIC_APP_DESCRIPTION=Configurable multi-platform content automation engine

# ── Public URLs (REQUIRED for server / on-prem) ───────────
# Use your real HTTPS hostnames in production — not localhost.
# Same reverse-proxy host is fine (e.g. both https://content.company.local).
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
# Optional extra CORS origins (comma-separated). Defaults to WEB_URL.
# CORS_ORIGINS=https://app.example.com,https://www.example.com

# ── Listen / ports ────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=4000
# PaaS often injects PORT — used as API_PORT fallback
# PORT=4000
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# Next.js server-side proxy to the API (Docker compose sets this automatically)
# INTERNAL_API_URL=http://api:4000
# Optional fallback used only if INTERNAL_API_URL / API_URL unset at web build:
# NEXT_PUBLIC_API_URL=

# ── Database ──────────────────────────────────────────────
# Production / Docker: USE_EMBEDDED_PG=false + real DATABASE_URL
USE_EMBEDDED_PG=false
DATABASE_URL=postgresql://contentpilot:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/contentpilot

# Docker Compose Postgres credentials (compose builds DATABASE_URL for the api service)
POSTGRES_USER=contentpilot
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=contentpilot

# Local-only embedded Postgres (not for production redeploys):
# USE_EMBEDDED_PG=true
# EMBEDDED_PG_HOST=127.0.0.1
# EMBEDDED_PG_PORT=5433
# EMBEDDED_PG_USER=contentpilot
# EMBEDDED_PG_PASSWORD=contentpilot
# EMBEDDED_PG_DATABASE=contentpilot
# EMBEDDED_PG_DATA_DIR=./data/postgres
# DATABASE_URL=postgresql://contentpilot:contentpilot@127.0.0.1:5433/contentpilot

# ── Redis (optional) ──────────────────────────────────────
# Empty = inline jobs (no Redis). Docker compose sets redis://redis:6379.
REDIS_URL=redis://127.0.0.1:6379

# ── Security (REQUIRED — generate unique values per install) ─
# openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING________________
# Must stay stable forever — rotating invalidates encrypted API tokens in DB
ENCRYPTION_KEY=CHANGE_ME_TO_A_RANDOM_32_PLUS_CHAR_KEY______________
SESSION_MAX_AGE_MS=2592000000
COOKIE_NAME=contentpilot.sid
# Local http:// → false. Production HTTPS / reverse proxy → true
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Only if web + API share a parent domain on different hosts:
# COOKIE_DOMAIN=.example.com
# Behind nginx/Caddy/Traefik set true so Secure cookies + client IP work
TRUST_PROXY=false

# ── Persistent media (CRITICAL for redeploys) ─────────────
# Docker Compose forces UPLOAD_DIR=/app/uploads (named volume uploads_data).
# Bare metal: use an absolute path outside the app tree, e.g.:
# UPLOAD_DIR=/var/lib/contentpilot/uploads
UPLOAD_DIR=./uploads
MEDIA_STORAGE=local
MEDIA_SIGNED_URL_TTL_SECONDS=3600

# ── LLM / Image (prefer Settings UI; env = global fallback) ─
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=4096
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
IMAGE_PROVIDER=fal
FAL_MODEL=fal-ai/flux-pro/v1.1
FAL_API_KEY=

SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SERPAPI_API_KEY=

SCRAPING_PROVIDER=apify
APIFY_API_TOKEN=

NOTIFICATION_PROVIDER=slack
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
# Resend (email alerts) — free: 100/day, 3k/mo. https://resend.com
RESEND_API_KEY=
# From: verified domain, or beth.t@example.com for free tests to your Resend account email
NOTIFICATION_FROM_EMAIL=
NOTIFICATION_TO_EMAIL=
# Optional SMTP fallback (unused when RESEND_API_KEY is set)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Optional global Placid token — prefer Brand Studio / Settings per tenant
PLACID_API_KEY=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300
MAX_REVISION_CYCLES=5
PUBLISH_POLL_INTERVAL_MS=5000
PUBLISH_POLL_MAX_ATTEMPTS=6
